# ==============================
# KAIRO AI CONFIGURATION
# ==============================

GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

DEEPGRAM_API_KEY=PASTE_YOUR_DEEPGRAM_API_KEY_HERE

# Optional TTS provider
TTS_PROVIDER=browser

# ==============================
# DATABASE
# ==============================

DATABASE_URL=postgresql+asyncpg://kairo:kairo@localhost:5432/kairo

# ==============================
# APPLICATION
# ==============================

APP_ENV=development
APP_NAME=KAIRO
APP_VERSION=1.0.0

FRONTEND_URL=http://localhost:3000

LOG_LEVEL=INFO

# ==============================
# SECURITY
# ==============================

SECRET_KEY=CHANGE_THIS_IN_LOCAL_ENVIRONMENT

# ==============================
# DEMO MODE
# ==============================

DEMO_MODE=false